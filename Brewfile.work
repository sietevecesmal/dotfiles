# Work packages, installed on top of Brewfile when DOTFILES_PROFILE=work

tap "arttor/tap"
tap "cue-lang/tap"
tap "derailed/k9s"

brew "argocd"
brew "arttor/tap/helmify"
brew "aws-iam-authenticator"
brew "cloudflared"
brew "cue-lang/tap/cue"
brew "derailed/k9s/k9s"
brew "helm"
brew "istioctl"
brew "kind"
brew "kubectx"
brew "kubernetes-cli"
brew "kubevela"
brew "kustomize"
brew "pluto"

if OS.mac?
  brew "colima"
  brew "docker"
  brew "docker-buildx"

  cask "headlamp"
  cask "lastpass"
  cask "lens"
  cask "linear"
  cask "postico"
  cask "session-manager-plugin"
  cask "slack"
end
